# Linux X11 display used by the Kinect/OpenCV controller window.
DISPLAY=:0

# Optional controller defaults. Uncomment in docker-compose.yml if you want no prompts.
# DIFFICULTY=M
# THINK_TIME=0.5

# Choose the physical human side.
# black = robot/Stockfish starts as White.
# white = human starts as White.
HUMAN_COLOR=black

# Baxter limb used when /status builds robot_ros_commands
ROBOT_LIMB=left
